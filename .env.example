# ==============================================================================
# AVAREST ONE — ENVIRONMENT CONFIGURATION TEMPLATE
# Never commit real secrets. Copy to .env for local staging development.
# ==============================================================================

# Active Environment: 'staging' (default) or 'production'
VITE_ENVIRONMENT="staging"
AVAREST_ENVIRONMENT="staging"

# Application URL & Optional External API Origin
APP_URL="http://localhost:3000"
VITE_API_URL=""

# ------------------------------------------------------------------------------
# PUBLIC FRONTEND SUPABASE CONFIGURATION (Browser-Safe Anon Key Only)
# STAGING PROJECT:    avarest-ai-staging (https://wdbtszlcdliwacvztmjl.supabase.co)
# PRODUCTION PROJECT: avarest-ai         (https://zdvhksmtxelxcudssdus.supabase.co)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://wdbtszlcdliwacvztmjl.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_STAGING_SUPABASE_ANON_KEY"

# ------------------------------------------------------------------------------
# SERVER-SIDE PRIVILEGED CREDENTIALS (NEVER prefix with VITE_!)
# Configure via Cloudflare Workers Secrets / AI Studio Secrets panel
# ------------------------------------------------------------------------------
SUPABASE_URL="https://wdbtszlcdliwacvztmjl.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_STAGING_SUPABASE_SERVICE_ROLE_KEY"

# Local Session Signing Secret (used only for local staging sandbox auth when Supabase keys are absent)
AUTH_SESSION_SECRET="CHANGE_ME_LOCAL_DEV_RANDOM_32_CHARS"

# One-time First-Admin Bootstrap Secret (only succeeds when zero admins exist)
ADMIN_BOOTSTRAP_SECRET=""

# Active AI Provider API Keys (Server-Side Only — Initial 4-Provider Release)
OPENAI_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
